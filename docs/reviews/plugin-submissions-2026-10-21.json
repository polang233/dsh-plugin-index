        "bundlePatch": "# This bundle owns no configuration rows of its own.\n#\n# It inserts one row that loads the plugin. The plugin takes the mounted\n# Session Query service (`ctx.sessionQuery`) and replaces only its\n# `searchSessions` method, so the sidebar's 250 ms-debounced content search\n# uses literal substring matching instead of the FTS5 `unicode61` token\n# matcher. Exact reads, titles, traces, and filters keep working unchanged.\n- insert:\n    - id: session-fulltext\n      name: 'dsh-plugin-session-fulltext'\n      config:\n        # Debug logging is opt-in: set `debug: true` in a profile patch to\n        # write `$DSH_HOME/session-fulltext.log` (activation, warm-up and search\n        # traffic). It never affects search behavior.\n        debug: false\n",
        "archive": {
          "bytes": 17377,
          "sha512Verified": true,
          "inspection": "Archive bytes read in memory to compute SHA-512; not written, unpacked, installed or executed."
        },
        "publishedManifest": {
          "name": "dsh-plugin-session-fulltext",
          "version": "1.0.0",
          "license": "MIT",
          "engines": {
            "dsh": ">=0.2.1-rc.2 <0.3.0"
          },
          "peerDependencies": null,
          "exports": {
            ".": "./index.js",
            "./client": "./lib/client.js",
            "./package.json": "./package.json",
            "./locale/*.json": "./locale/*.json",
            "./cordis.patch.yml": "./cordis.patch.yml"
          },
          "dsh": {
            "bundle": {
              "patch": "./cordis.patch.yml"
            },
            "client": {
              "inject": [
                "@deepseek-ai/dsh-api-session-controller"
              ],
              "platform": "web"
            }
          },
          "private": false
        }
      },
