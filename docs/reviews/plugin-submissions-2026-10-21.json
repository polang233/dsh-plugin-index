        "bundlePatch": "# dsh-global-todo — bundle patch\n#\n# This file is the plugin's own configuration layer. It contributes exactly one\n# Loader row; the profile's `cordis.patch.yml` can target that row id (`global-todo`)\n# to override `config` or set `disabled: true`.\n#\n# `config` is replaced wholesale by an override, not deep-merged: when you override\n# it, restate every key you want to keep.\n- insert:\n    - id: global-todo\n      name: 'dsh-global-todo'\n      config:\n        # Where the list lives. Empty = `$DSH_HOME/global-todo/todos.json`.\n        # Point it at a notes repo or a synced folder to make the list portable.\n        storePath: ''\n        # Default working directory for 「new session」 dispatch. Empty = let the\n        # harness decide (default workspace).\n        dispatchDir: ''\n        # How many activity entries each todo keeps (audit trail, oldest dropped).\n        activityLimit: 50\n        # Reject links whose file path does not exist at write time. `false` lets\n        # you attach a document before creating it.\n        requireExistingFiles: true\n        # Inject the short usage guidance into every turn. `false` leaves the tools\n        # available but stops asking the model to record things on its own.\n        guidance: true\n        # Starting point for the panel's built-in folder browser when the shell has\n        # no native picker. Empty = home directory, then the Host's cwd.\n        browseRoot: ''\n",
