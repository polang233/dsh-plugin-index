      "securityReview": {
        "scope": "Published first-party Host/client/auth/bili/danmaku/trust code, patch and corresponding immutable public source; unchanged vendored assets compared by bytes",
        "priorConclusion": "0.2.0 was held for missing evidence of raw-route browser trust controls and unbound QR polling, not a confirmed CSRF or privacy exploit.",
        "controls": [
          {
            "paths": [
              "trust.js:46-63,72-80,128-193",
              "index.js:703-725"
            ],
            "note": "All API dispatch passes a loopback Host fence and Origin/HTTP Referer plus Sec-Fetch-Site checks. Rejects non-loopback DNS authorities, cross-site marker, opaque Origin, mismatched port/origin. This is browser request trust, not user authentication."
          },
          {
            "paths": [
              "index.js:117-182,1009-1078"
            ],
            "note": "QR generation keeps upstream key in Host, issues random UUID capability bound to the locally created challenge. Poll rejects missing/unknown/expired token and mismatched legacy key; terminal results and upstream errors delete the token; capped map and TTL timers bound retained sessions."
          },
          {
            "paths": [
              "index.js:1080-1134",
              "client.js:474-504,1949-2060,2092-2100"
            ],
            "note": "JSON-only bounded cancel body, idempotent cancellation, logout invalidation and in-memory client token cleanup on close/retry/unmount. Tokens in memory do not protect against same-origin malicious code."
          },
          {
            "paths": [
              "index.js:239-273,518-568,1404-1416"
            ],
            "note": "Only capability-bearing media routes and public immutable vendor assets use Host-only trust. Media maps are bounded, random and expiring, with CDN HTTPS URL allowlisting; API responses have no permissive CORS."
          },
          {
            "paths": [
              "auth.js:23-139"
            ],
            "note": "Unchanged cookie-bearing requests restrict Bilibili HTTPS hosts and reject redirects; cookie values filtered, saved locally with POSIX mode when supported and redacted from logs. Stream proxy uses no account cookie, so do not generalize the auth redirect policy to it."
          }
        ],
        "findings": [],
        "limitations": [
          "Single local-user/loopback service, not multi-user authentication or a guarantee against local processes or same-origin code.",
          "Missing browser markers are allowed; media capability routes intentionally allow CORS. Review covers the stated loopback threat model.",
          "No real login, playback, GUI runtime, OS ACL verification or exhaustive vendored/transitive dependency audit; source comparison is not a reproducible build claim.",
          "Cancellation does not abort an already-running upstream login poll; cooperative local UI and upstream latency still apply."
        ]
      }
