{
  "name": "dsh-open-market",
  "version": "0.4.0-dev.1",
  "description": "Discover and manage community plugins in DeepSeek Harness with search, grouped favorites, version switching and updates.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./auto-review": "./auto-review/index.js",
    "./auto-review/locale/*.json": "./auto-review/locale/*.json",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "self-update.js",
    "profile-state.js",
    "bundle-update.js",
    "management.js",
    "task-guard.js",
    "diagnostics.js",
    "theme-assets.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "theme/theme.css",
    "theme/*.webp",
    "auto-review/index.js",
    "auto-review/locale/*.json",
    "locale/*.json",
    "README.md",
    "DETAIL.md",
    "DETAIL.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin-market",
    "plugin-index"
  ],
  "author": "polang233",
  "license": "GPL-3.0-only",
  "homepage": "https://dshopen.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polang233/dsh-plugin-index.git",
    "directory": "packages/dsh-open-market"
  },
  "bugs": "https://github.com/polang233/dsh-plugin-index/issues",
  "engines": {
    "dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}
