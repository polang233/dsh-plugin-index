// dshopen.org: the built site from public/, plus read counts for index.json.
// Deploy: pnpm build, then `npx wrangler deploy --config cloudflare/wrangler.jsonc`.
{
  "name": "dshopen",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "account_id": "f3ec0933397fd17fe1e7d472f4c95927",
  // Match the active Worker's dashboard configuration when uploading a new version.
  "cache": { "enabled": true, "cross_version_cache": false },
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths run the Worker; everything else is served straight from the asset store.
    "run_worker_first": ["/index.json", "/stats.json", "/likes.json", "/api/*", "/badge/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dshopen-stats", "database_id": "408308fd-fe81-4fdd-8b5d-ce3447e53eb6" }
  ],
  "routes": [
    { "pattern": "dshopen.org", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
